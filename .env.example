# Copy this file to `.env` and fill in values. `.env` is gitignored — never commit real secrets.
# Only DEEPSEEK_API_KEY is strictly required to boot (see src/config.ts); everything else is
# optional and feature-gated. Defaults shown are the same defaults the code falls back to.

# ---- Required ----
DEEPSEEK_API_KEY=

# ---- DeepSeek (optional) ----
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- PoC state store (optional; defaults to local JSON file store) ----
# POC_STORE_MODE: file | sqlite. SQLite uses Node's built-in node:sqlite; no PGSQL server needed.
POC_STORE_MODE=sqlite
POC_STORE_PATH=.data/pocs.json
SQLITE_DB_PATH=.data/pocs.sqlite

# ---- Email (optional; defaults to local in-memory email) ----
# EMAIL_MODE: local | gmail_mcp | gmail_api.
# gmail_mcp creates Gmail drafts via official Gmail MCP. gmail_api sends directly via
# Gmail REST users.messages.send using an OAuth token with gmail.send or gmail.compose.
EMAIL_MODE=local
EMAIL_FROM=PoC Team <poc@example.com>
GMAIL_MCP_ENDPOINT=https://gmailmcp.googleapis.com/mcp/v1
GMAIL_MCP_USER_PROJECT=
# GMAIL_MCP_PROVIDER: google | workspace. google uses create_draft/search_threads/get_thread;
# workspace uses Workspace MCP outbound tools like draft_gmail_message/send_gmail_message.
GMAIL_MCP_PROVIDER=google
# GMAIL_MCP_DELIVERY_MODE: draft | send. Keep draft until live Workspace MCP sending is tested.
GMAIL_MCP_DELIVERY_MODE=draft
GMAIL_MCP_ACCESS_TOKEN=
GMAIL_API_BASE_URL=https://gmail.googleapis.com
GMAIL_API_USER_ID=me
GMAIL_API_ACCESS_TOKEN=
# Required only for the guarded direct-send smoke check.
GMAIL_API_SEND_SMOKE=0
GMAIL_API_SEND_SMOKE_TO=
GMAIL_API_INBOX_SMOKE_QUERY=
GMAIL_API_INBOX_SMOKE_MAX_THREADS=3
GMAIL_API_INBOX_SMOKE_REQUIRE_PROCESSED=0
GMAIL_API_INBOX_SMOKE_POC_ID=poc_gmail_api_inbox_smoke
GMAIL_INBOX_QUERY=in:inbox newer_than:7d -in:draft
GMAIL_INBOX_MAX_THREADS=10
# Comma-separated Gmail label IDs, not label names. Use Gmail MCP list_labels to find IDs.
GMAIL_PROCESSED_LABEL_IDS=

# ---- Google OAuth test connector (optional; in-memory only) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=openid email profile https://mail.google.com/ https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.readonly
GOOGLE_OAUTH_TOKEN_STORE_PATH=.data/google-oauth-token.json
GMAIL_MCP_SMOKE_TO=

# ---- Secrets store (optional; defaults to an encrypted local file) ----
SECRETS_MODE=encrypted_file
SECRET_ENCRYPTION_KEY=
SECRETS_STORE_PATH=.data/secrets.json
SECRETS_BASE_URL=http://localhost:3000/secrets

# ---- PostHog (optional) ----
POSTHOG_MCP_API_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_ORGANIZATION_ID=
POSTHOG_MCP_ENDPOINT=https://mcp.posthog.com/mcp?tools=project-get,project-settings-update,action-create,dashboard-create,insight-create,cohorts-create,create-feature-flag,experiment-create,survey-create,alert-create,read-data-schema,execute-sql,query-session-recordings-list,survey-stats,surveys-responses-list
POSTHOG_SYNTHETIC_VERIFY_ATTEMPTS=5
POSTHOG_SYNTHETIC_VERIFY_DELAY_MS=2000
# Required only for the mutating disposable-project smoke check.
POSTHOG_MCP_MUTATION_SMOKE=0
POSTHOG_MCP_MUTATION_SMOKE_PREFIX=
POSTHOG_MCP_MUTATION_SMOKE_PROJECT_SETTINGS_JSON={}

# ---- Server ----
# WORKFLOW_MODE=local runs the whole flow in-process (real results over HTTP, no Trigger deploy);
# default "trigger" dispatches to Trigger.dev workers. local mode still needs DEEPSEEK_API_KEY.
WORKFLOW_MODE=trigger
PORT=3000
HOST=127.0.0.1

# ---- Trigger.dev (Trigger.dev Cloud) ----
# Hosted Trigger.dev Cloud API. Override only for self-hosted Trigger.dev.
TRIGGER_API_URL=https://api.trigger.dev
# Project ref (proj_...) from the Trigger.dev dashboard. Also read by trigger.config.ts.
TRIGGER_PROJECT_REF=
# Runtime secret key (tr_dev_... / tr_prod_...) from the dashboard "API keys" page.
# REQUIRED when WORKFLOW_MODE=trigger: the API server reads it to call task.trigger().
TRIGGER_SECRET_KEY=
# Personal Access Token (tr_pat_...) for non-interactive `npm run trigger:deploy` / CI only.
# Not needed for local dev if you run `npx trigger.dev@4.4.6 login` interactively.
TRIGGER_ACCESS_TOKEN=

# ---- Approval page (optional) ----
APPROVAL_BASE_URL=http://localhost:3000/approval
